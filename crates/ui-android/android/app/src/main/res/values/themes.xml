<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: GameActivity (MainActivity) extends AppCompatActivity and
         requires a Theme.AppCompat descendant, or setContentView throws
         IllegalStateException at runtime. Theme.Leanback is not AppCompat-based. -->
    <style name="Theme.Frenchetv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Full-screen: no status bar, no nav bar -->
    <style name="Theme.Frenchetv.Fullscreen" parent="Theme.Frenchetv">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
